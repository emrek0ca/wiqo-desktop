{
  "sourceLanguage": "tr",
  "strings": {
    "\n\nBu PC komutları hazırlanıp yerel cihaza gönderilecek; gerçek sonucu henüz doğrulamadım.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nThese PC commands have been prepared and will be sent to the local device; I have not yet verified the actual result."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDiese PC-Befehle werden vorbereitet und an das lokale Gerät gesendet; das tatsächliche Ergebnis wurde noch nicht bestätigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nEstos comandos de PC se prepararán y enviarán al dispositivo local; aún no he verificado el resultado real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nCes commandes PC seront préparées et envoyées à l’appareil local ; je n’ai pas encore vérifié le résultat réel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nستُعد أوامر هذا الكمبيوتر وسيتم إرسالها إلى الجهاز المحلي؛ لم أتحقق من النتيجة الفعلية بعد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nЭти команды для ПК будут подготовлены и отправлены на локальное устройство; реальный результат пока не проверен."
          }
        }
      }
    },
    "\n\nBu cihaz eylemleri henüz çalıştırılmadı; önce uygulamadaki onayını bekliyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nThese device actions have not yet been executed; they are waiting for approval in the app first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDiese Geräteaktionen wurden noch nicht ausgeführt; sie warten zunächst auf die Genehmigung in der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nEstas acciones en el dispositivo aún no se han ejecutado; están esperando tu aprobación en la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nCes actions sur l’appareil n’ont pas encore été exécutées ; elles attendent votre confirmation dans l’application."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nلم تُنفَّذ إجراءات هذا الجهاز بعد؛ تنتظر الموافقة داخل التطبيق أولاً."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nЭти действия на устройстве ещё не выполнены; ждём подтверждения в приложении."
          }
        }
      }
    },
    "\n\nOnayını bekliyor; onay verdiğinde PC'de çalıştırılacak.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nWaiting for approval; once approved it will run on the PC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nWarten auf Genehmigung; wird auf dem PC ausgeführt, sobald sie erteilt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nEsperando tu aprobación; cuando la otorgues, se ejecutará en el PC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nEn attente de votre confirmation ; une fois accordée, elles seront exécutées sur le PC."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nانتظار الموافقة؛ عند إعطائها ستُنفَّذ على الكمبيوتر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nОжидается подтверждение; после него будет выполнено на ПК."
          }
        }
      }
    },
    "\n\nPC'de çalıştırılıyor; gerçek sonuç doğrulanınca burada gösterilecek.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nRunning on the PC; the real result will be shown here once verified."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nWird auf dem PC ausgeführt; das echte Ergebnis wird hier angezeigt, sobald es bestätigt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nSe está ejecutando en el PC; se mostrará aquí una vez que el resultado real sea verificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nExécution sur le PC ; le résultat réel sera affiché ici une fois vérifié."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nيتم تشغيلها على الكمبيوتر؛ ستُعرض هنا عند التحقق من النتيجة الفعلية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nВыполняется на ПК; реальный результат будет показан здесь после проверки."
          }
        }
      }
    },
    "\n\nPC'de çalıştırılıyor…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nRunning on the PC…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nWird auf dem PC ausgeführt…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nSe está ejecutando en el PC…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nExécution sur le PC…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nيتم تشغيلها على الكمبيوتر…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nВыполняется на ПК…"
          }
        }
      }
    },
    "\n\nYerel sonuç alındı; kalan adımı tamamlayamadım.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nLocal result received; I couldn't complete the remaining step."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nLokales Ergebnis erhalten; konnte den letzten Schritt nicht abschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nResultado local recibido; no pude completar el paso restante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nRésultat local reçu ; je n’ai pas pu terminer l’étape suivante."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nتم الحصول على النتيجة المحلية؛ لم أتمكن من إكمال الخطوة المتبقية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nПолучен локальный результат; оставшийся шаг не удалось завершить."
          }
        }
      }
    },
    "\n\nİstediklerini sırayla yapıyorum…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nI'm doing what you asked, one step at a time…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nIch erledige deine Wünsche nacheinander…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nEstoy haciendo lo que pides, uno por uno…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nJe réalise vos demandes une par une …"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nأقوم بتنفيذ ما تريد بالتسلسل…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nВыполняю ваши запросы по порядку…"
          }
        }
      }
    },
    "\n\nİstediklerini yaptım.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nI did what you wanted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nIch habe deine Wünsche erledigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nLo he hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nJ’ai effectué ce que vous avez demandé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nأنجزت ما طلبته."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nВыполнил всё, что вы просили."
          }
        }
      }
    },
    "\n\nİstediğin işlemi PC'ye gönderiyorum; gerçek sonucu alınca haber vereceğim.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nI'm sending the requested action to the PC; I'll let you know when the real result is obtained."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nIch sende die gewünschte Aktion an den PC; ich informiere dich, sobald das echte Ergebnis vorliegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nEstoy enviando la operación al PC; te avisaré cuando obtenga el resultado real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nJe transmets votre action au PC ; je vous informerai dès que le résultat réel sera disponible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nأرسل العملية إلى الكمبيوتر؛ سأخبرك عند الحصول على النتيجة الفعلية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nОтправляю ваш запрос на ПК; как только получу реальный результат, сообщу."
          }
        }
      }
    },
    "\n\nİşlem iptal edildi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nThe operation was cancelled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAktion abgebrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nOperación cancelada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAction annulée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nتم إلغاء العملية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nОперация отменена."
          }
        }
      }
    },
    " Geri alabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " You can undo it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Du kannst es rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Puedes deshacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Vous pouvez revenir en arrière."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " يمكنك التراجع."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Вы можете откатить."
          }
        }
      }
    },
    " başlatılıyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Starting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " wird gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " iniciando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " démarrage."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " يُبدأ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Запускается."
          }
        }
      }
    },
    " isteği PC'de çalıştırılıyor; gerçek sonuç doğrulanınca burada göstereceğim.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " The request is being executed on the PC; the real result will be shown here once verified."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Die Anfrage wird auf dem PC ausgeführt; das echte Ergebnis wird hier angezeigt, sobald es bestätigt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " la solicitud se ejecuta en el PC; te mostraré el resultado real cuando esté verificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " L’action est exécutée sur le PC ; le résultat réel sera affiché ici une fois vérifié."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " يُنفَّذ الطلب على الكمبيوتر؛ سأعرض النتيجة عند التحقق."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Запрос выполняется на ПК; реальный результат будет показан здесь после проверки."
          }
        }
      }
    },
    " için onayını bekliyorum.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Waiting for your approval for"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Ich warte auf deine Genehmigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " esperando tu aprobación para."
          }
        },
        "fr": {
