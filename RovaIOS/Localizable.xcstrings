      }
    },
    "Wiqo hesabından çıkmak istediğine emin misin?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to sign out of Wiqo?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist du sicher, dass du dich aus dem Wiqo-Konto abmelden möchtest?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres cerrar sesión en la cuenta de Wiqo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir vous déconnecter du compte Wiqo?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد أنك تريد تسجيل الخروج من حساب Wiqo؟"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите выйти из учётной записи Wiqo?"
          }
        }
      }
    },
    "Wiqo ile eşleştirilmiş PC'de oynatmayı durdurur ya da devam ettirir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo pauses or resumes playback on the paired PC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo stoppt oder setzt die Wiedergabe auf dem verbundenen PC fort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo detiene o reanuda la reproducción en el PC emparejado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo arrête ou reprend la lecture sur le PC apparié."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف أو يواصل تشغيل Wiqo على PC المتطابق أو يواصله."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo останавливает или продолжает воспроизведение на сопряжённом PC."
          }
        }
      }
    },
    "Wiqo ile eşleştirilmiş PC'nin sesini kısar veya açar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo mutes or unmutes the paired PC's sound."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo passt die Lautstärke des verbundenen PCs an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo silencia o activa el sonido del PC emparejado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo baisse ou augmente le volume du PC apparié."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفض أو يرفع صوت Wiqo على PC المتطابق."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo регулирует громкость сопряжённого PC."
          }
        }
      }
    },
    "Wiqo ile eşleştirilmiş PC'yi uyku moduna alır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo puts the paired PC to sleep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo schaltet den verbundenen PC in den Ruhezustand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo pone el PC emparejado en modo de suspensión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo met le PC apparié en mode veille."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع Wiqo على PC المتطابق في وضع السبات."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo переводит сопряжённый PC в режим сна."
          }
        }
      }
    },
    "Wiqo ile eşleştirilmiş PC'yi uzaktan kilitler.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo locks the paired PC remotely."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo sperrt den verbundenen PC aus der Ferne"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo bloquea el PC emparejado a distancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo verrouille à distance le PC apparié."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقفل Wiqo على PC المتطابق عن بُعد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo удалённо блокирует сопряжённый PC."
          }
        }
      }
    },
    "Wiqo işi kuyruktan aldı; PC'ye gönderilmiş bir adımın sonucu doğrulanamadı. Etkinlik'teki kontrol uyarısına bak.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo removed the job from the queue; the result of a step sent to the PC could not be verified. Check the warning in Activity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo hat die Aufgabe aus der Warteschlange entfernt; das Ergebnis eines an den PC gesendeten Schritts konnte nicht bestätigt werden. Siehe die Warnung in der Aktivität."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo retiró la tarea de la cola; el resultado de un paso enviado a PC no se pudo verificar. Consulta la advertencia de control en la actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo a retiré la tâche de la file d'attente ; le résultat d'une étape envoyée au PC n'a pas pu être vérifié. Consultez l'avertissement de contrôle dans l'Activité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo أخذ المهمة من الطابور؛ لم يتم التحقق من نتيجة خطوة تم إرسالها إلى PC. راجع تحذير التحقق في النشاط."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo удалил задачу из очереди; результат шага, отправленного на PC, не подтверждён. Проверьте предупреждение в разделе События."
          }
        }
      }
    },
    "Wiqo komutunu onaylayın": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm Wiqo command"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige den Wiqo-Befehl"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma el comando de Wiqo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez la commande Wiqo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وافق على أمر Wiqo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите команду Wiqo"
          }
        }
      }
    },
    "Wiqo projeyi durdurur; o ana kadar yapılan kısım teslim edilmez.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo stops the project; partial work is not submitted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo beendet das Projekt; bisherige Arbeit wird nicht übergeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo detiene el proyecto; la parte realizada hasta ese momento no se entrega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo arrête le projet ; la partie réalisée jusqu'ici n'est pas livrée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف Wiqo المشروع؛ لا يُسلم الجزء الذي تم إنجازه حتى الآن."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo останавливает проект; сделанная часть не передаётся."
          }
        }
      }
    },
    "Wiqo projeyi durdurur; yarım kalan iş teslim edilmez.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo stops the project; unfinished work is not submitted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo beendet das Projekt; unvollständige Arbeit wird nicht übergeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo detiene el proyecto; el trabajo incompleto no se entrega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo arrête le projet ; le travail inachevé n'est pas livré."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف Wiqo المشروع؛ لا يُسلم العمل غير المكتمل."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo останавливает проект; незавершённая работа не передаётся."
          }
        }
      }
    },
    "Wiqo sana bu şekilde hitap eder.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo addresses you this way."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo spricht dich so an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo te saluda de esta manera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo vous salue ainsi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُتحدث إليك Wiqo بهذه الطريقة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo обращается к вам так."
          }
        }
      }
    },
    "Wiqo seni izliyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo is watching you"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo beobachtet dich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo te está observando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo vous surveille"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يراقبك Wiqo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo наблюдает за вами"
          }
        }
      }
    },
    "Wiqo senin hakkında öğrendiği her şeyi unutur. Bu geri alınamaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo forgets everything it learns about you. This is irreversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo vergisst alles, was es über dich gelernt hat. Das ist unwiderruflich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo olvida todo lo que ha aprendido sobre ti. Esto es irreversible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo oubliera tout ce qu'il a appris à votre sujet. C'est irréversible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنسى Wiqo كل ما تعلمه عنك. لا يمكن التراجع."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo забудет всё, что узнал о вас. Это невозможно отменить."
          }
        }
      }
    },
    "Wiqo sunucusu isteği tamamlayamadı. Lütfen tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo server request failed. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wiqo-Server konnte die Anfrage nicht abschließen. Bitte versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de Wiqo no pudo completar la solicitud. Por favor, inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur Wiqo n'a pas pu terminer la requête. Veuillez réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل طلب خادم Wiqo. حاول مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер Wiqo не смог завершить запрос. Пожалуйста, повторите попытку."
          }
        }
      }
    },
    "Wiqo sunucusu zamanında yanıt vermedi. Biraz sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo server did not respond in time. Try again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo-Server hat nicht rechtzeitig geantwortet. Bitte später erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de Wiqo no respondió a tiempo. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur Wiqo n’a pas répondu à temps. Réessayez plus tard."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يرد خادم Wiqo في الوقت المحدد. حاول مرة أخرى لاحقًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер Wiqo не ответил вовремя. Попробуйте позже."
          }
        }
      }
    },
    "Wiqo sunucusu çalıştırıp bildiriyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo runs the server and reports"
          }
        },
        "de": {
