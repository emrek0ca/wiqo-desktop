    "App Store fiyatı şu anda alınamadı. Az sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to retrieve App Store price right now. Please try again shortly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App‑Store‑Preis konnte derzeit nicht abgerufen werden. Versuche es in Kürze erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener el precio de la App Store en este momento. Inténtalo de nuevo en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'obtenir le prix App Store pour le moment. Réessayez dans un instant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الحصول على سعر App Store الآن. حاول مرة أخرى لاحقًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущую цену в App Store получить не удалось. Попробуйте позже."
          }
        }
      }
    },
    "App Store’a bağlanılamadı. Bağlantını kontrol edip tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
