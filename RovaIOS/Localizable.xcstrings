    "Her gün 09:00'da Rahatsız Etme'yi açan, 18:00'de kapatan bir otomasyon oluştur.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an automation that turns on Do Not Disturb at 09:00 and turns it off at 18:00 every day"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine Automatisierung, die den Fokusmodus jeden Tag um 09:00 einschaltet und um 18:00 wieder ausschaltet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una automatización que active el modo No Molestar a las 09:00 y lo desactive a las 18:00 cada día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée une automatisation qui active le mode Ne pas déranger à 09h00 et le désactive à 18h00 chaque jour"
          }
