    "Görev beklenenden uzun sürdü; biraz sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task took longer than expected; try again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe dauerte länger als erwartet; versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea tardó más de lo esperado; inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche a pris plus de temps que prévu ; réessayez plus tard."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق المهمة وقتاً أطول من المتوقع؛ حاول مرة أخرى لاحقاً."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задача заняла больше времени, чем ожидалось. Попробуйте позже."
          }
        }
      }
    },
