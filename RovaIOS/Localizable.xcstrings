    "Silinemedi (bağlantıyı kontrol et); proje diğer cihazlarda geri gelirdi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not delete (check the connection); the project would have returned on other devices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gelöscht (Verbindung prüfen); Projekt würde auf anderen Geräten zurückkehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
