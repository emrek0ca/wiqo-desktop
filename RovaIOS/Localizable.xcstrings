    },
    "Sunucudaki şifreli kopya silinemedi; bağlantıyı kontrol et.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted copy on server could not be deleted; check the connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselte Kopie auf dem Server konnte nicht gelöscht werden; Verbindung prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar la copia cifrada en el servidor; verifica la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer la copie chiffrée sur le serveur ; vérifiez la connexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حذف النسخة المشفرة على الخادم؛ تحقق من الاتصال."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось удалить зашифрованную копию на сервере; проверьте соединение."
          }
        }
      }
    },
    "Sunucudan geçersiz bir yanıt alındı. Lütfen tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
