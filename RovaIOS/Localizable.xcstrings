    "Gizlilik Politikası'nı aç" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح سياسة الخصوصية"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Datenschutzerklärung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Privacy Policy"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir Política de Privacidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir la Politique de confidentialité"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть Политику конфиденциальности"
          }
        }
      }
    },
    "Gizlilik Politikası'nı okudum. Mesaj, ses ve görsellerimin yanıt üretmek için Wiqo tarafından yapay zeka hizmet sağlayıcılarıyla işlenmesini kabul ediyorum." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرأت سياسة الخصوصية. أوافق على معالجة رسائلي، صوتي، وصورتي من قبل مزودي خدمات الذكاء الاصطناعي في Wiqo لإنتاج الردود."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe die Datenschutzerklärung gelesen. Ich akzeptiere, dass meine Nachrichten, Audios und Bilder von Wiqo zur Antwortgenerierung mit KI-Dienstleistern verarbeitet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have read the Privacy Policy. I accept that my messages, voice, and images are processed by Wiqo with AI service providers to generate responses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He leído la Política de Privacidad. Acepto que mis mensajes, audio y visuales sean procesados por proveedores de servicios de IA de Wiqo para generar respuestas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai lu la Politique de confidentialité. J’accepte que mes messages, voix et images soient traités par des fournisseurs de services d’IA de Wiqo pour générer des réponses."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я прочитал Политику конфиденциальности. Я соглашаюсь, что мои сообщения, голос и изображения обрабатываются поставщиками искусственного интеллекта Wiqo для генерации ответов."
          }
        }
      }
    },
