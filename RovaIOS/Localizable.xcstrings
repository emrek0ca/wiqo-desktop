        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zum App Store fehlgeschlagen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar a la App Store. Verifica tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se connecter à l'App Store. Vérifiez votre connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الاتصال بـ App Store. تحقق من اتصالك ثم حاول مرة أخرى."
