        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ أتمتة تلخص أحداث تقويمك الأسبوعية في 08:30 كل إثنين."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте автоматизацию, которая в каждое понедельник в 08:30 подытожит события календаря за неделю."
          }
        }
      }
    },
    "Her ayın 1'inde saat 09:00'da o ay için bütçe/faturalarımı gözden geçirmemi hatırlatan bir otomasyon oluştur.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an automation that reminds me to review my budget/bills for the month every 1st of the month at 9:00 AM."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine Automatisierung, die jeden Monat am 1. um 09:00 Uhr mich daran erinnert, mein Budget/Meine Rechnungen für den Monat zu überprüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear una automatización que recuerde revisar el presupuesto/facturas del mes cada 1 de mes a las 09:00."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une automatisation qui vous rappelle de revoir votre budget/factures du mois chaque 1er à 09 h00."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ أتمتة تُذكّرني بمراجعة ميزانيتي/فواتيري في 09:00 يوم 1 من كل شهر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте автоматизацию, которая в первый день каждого месяца в 09:00 напомнит мне проверить бюджет/счета за месяц."
          }
        }
      }
    },
    "Her ayın ilk günü bir hatırlatma gönderir": {
      "extractionState": "manual",
