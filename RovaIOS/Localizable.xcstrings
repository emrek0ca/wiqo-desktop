        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiqo oubliera tout ce qu'il a appris à votre sujet. C'est irréversible."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiqo забудет всё, что узнал о вас. Это невозможно отменить."
          }
        }
      }
    },
    "Wiqo sunucusu çalıştırıp bildiriyor" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
