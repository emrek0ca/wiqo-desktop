    "PC'min pili %20'nin altına düştüğünde bana haber veren bir otomasyon oluştur.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an automation that notifies me when my PC battery drops below 20%"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine Automatisierung, die mich benachrichtigt, wenn der Akku meines PCs unter 20 % fällt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una automatización que me avise cuando la batería de mi PC caiga por debajo del 20 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer une automatisation qui me prévient lorsque la batterie de mon PC descend en dessous de 20 %."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ أتمتة تُخبرني عندما تنخفض بطارية الكمبيوتر إلى أقل من 20٪"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте автоматизацию, которая уведомит меня, когда батарея моего ПК опустится ниже 20 %."
          }
        }
      }
    },
