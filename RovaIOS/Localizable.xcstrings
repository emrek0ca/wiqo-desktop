          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro n'est pas disponible dans cette région de magasin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro غير متاح في منطقة المتجر هذه."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro недоступен в этом региональном магазине."
          }
        }
      }
    },
    "Wiqo Pro şu anda App Store'dan alınamıyor. Az sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro cannot be obtained from the App Store right now. Try again shortly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro kann derzeit nicht aus dem App Store bezogen werden. Bitte versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro no se puede obtener actualmente desde el App Store. Inténtalo de nuevo en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro n'est pas disponible dans l'App Store pour le moment. Réessayez dans quelques instants."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro غير متاح حاليًا من App Store. حاول مرة أخرى بعد قليل."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro сейчас нельзя получить из App Store. Попробуйте позже."
          }
        }
      }
    },
    "Wiqo bunları daha önce onayladığın için artık sormadan yapıyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo does this automatically because you approved it before."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo führt diese Aktionen automatisch aus, weil du sie zuvor genehmigt hast"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo hace esto sin preguntar porque ya lo has aprobado antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo fait cela sans vous demander car vous l'avez déjà approuvé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي Wiqo هذه العمليات تلقائياً لأنك قد وافقت عليها مسبقاً."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo делает это автоматически, потому что вы уже одобрили."
          }
        }
      }
    },
    "Wiqo bunları hatırlamayı öneriyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo suggests remembering these"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo schlägt vor, dies zu merken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo sugiere que recuerde esto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo recommande de les mémoriser"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقترح Wiqo أن يتذكر هذه"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo рекомендует запомнить это"
          }
        }
      }
    },
    "Wiqo görevi o adımda bırakır; yarım sonuç teslim edilmez.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo stops the task at that step; unfinished results are not submitted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo lässt die Aufgabe an dieser Stelle stehen; unvollständige Ergebnisse werden nicht übergeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo deja la tarea en ese paso; no se entrega un resultado parcial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo abandonne la tâche à ce stade ; le résultat partiel n'est pas livré."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف Wiqo المهمة عند هذه الخطوة؛ لا يُسلم النتيجة غير المكتملة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo прекращает задачу на этом шаге; неполный результат не отправляется."
          }
        }
      }
    },
    "Wiqo hesabı": {
