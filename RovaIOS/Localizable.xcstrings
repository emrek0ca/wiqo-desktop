    "Bu görev boyunca Masaüstü, Belgeler ve İndirilenler içindeki hassas olmayan dosyaları okumaya izin ver": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow reading non-sensitive files in Desktop, Documents and Downloads during this task"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube während dieser Aufgabe das Lesen von nicht sensiblen Dateien in Desktop, Dokumente und Downloads"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite leer archivos no sensibles en Escritorio, Documentos y Descargas durante esta tarea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès aux fichiers non sensibles dans Bureau, Documents et Téléchargements pendant cette tâche"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالقراءة للملفات غير الحساسة في سطح المكتب، المستندات، والمجلدات المنزلة خلال هذه المهمة"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить чтение нечувствительных файлов в Рабочем столе, Документах и Загрузках в течение этой задачи"
          }
        }
      }
    },
    "Bu görev boyunca Masaüstü, Belgeler ve İndirilenler'de dosya okuma, klasör açma, taşıma, kopyalama ve yeniden adlandırmaya izin ver. Silme ve üzerine yazma hariç.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow reading, opening, moving, copying and renaming files and folders in Desktop, Documents and Downloads during this task, except deleting and overwriting"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube während dieser Aufgabe das Lesen, Öffnen, Verschieben, Kopieren und Umbenennen von Dateien in Desktop, Dokumente und Downloads. Löschen und Überschreiben sind ausgeschlossen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite leer, abrir, mover, copiar y renombrar archivos en Escritorio, Documentos y Descargas durante esta tarea. No incluye borrar ni sobrescribir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez la lecture, l’ouverture de dossiers, le déplacement, la copie et le renommage de fichiers dans Bureau, Documents et Téléchargements pendant cette tâche, mais pas la suppression ni l’écrasement"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بقراءة الملفات، فتح المجلدات، نقل، نسخ، وإعادة تسمية في سطح المكتب، المستندات، والمجلدات المنزلة خلال هذه المهمة. لا يُسمح بالحذف أو الكتابة فوق"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить чтение файлов, открытие папок, перемещение, копирование и переименование в Рабочем столе, Документах и Загрузках в течение этой задачи. Исключены удаление и перезапись."
          }
        }
      }
    },
