    "PC isteğinin dar semantik işlemi: açık uygulamaları sorma=list_running_applications; normal uygulama kontrolü=control_application; Wiqo görev tarayıcısını veya Google Chrome for Testing'i kapatma=close_managed_browser; diğerleri=none.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PC request semantic operation: ask for open apps=list_running_applications; normal app check=control_application; close Wiqo task browser or Google Chrome for Testing=close_managed_browser; others=none."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PC-Anfrage: semantische Auflösung: laufende Apps abfragen=list_running_applications; normale App‑Kontrolle=control_application; Wiqo‑Task‑Browser oder Google Chrome for Testing schließen=close_managed_browser; sonst=none."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Operación semántica estrecha de la solicitud del PC: preguntar aplicaciones abiertas=list_running_applications; control de aplicación normal=control_application; cerrar el navegador gestionado o Google Chrome for Testing=close_managed_browser; demás=none."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande de tâche PC : interroger les applications ouvertes = list_running_applications ; contrôle d’application = control_application ; fermer le navigateur géré ou Google Chrome for Testing = close_managed_browser ; autre = none."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية الطلب الدلالية للكمبيوتر: طلب التطبيقات المفتوحة=list_running_applications؛ فحص التطبيق العادي=control_application؛ إغلاق متصفح Wiqo أو Google Chrome for Testing=close_managed_browser؛ غير ذلك=none."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие по запросу ПК: запросить открытые приложения=list_running_applications; обычная проверка приложения=control_application; закрыть браузер Wiqo или Google Chrome for Testing=close_managed_browser; остальные=none."
          }
        }
      }
    },
