          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recibió una respuesta inválida del servidor. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse invalide reçue du serveur. Veuillez réessayer."
