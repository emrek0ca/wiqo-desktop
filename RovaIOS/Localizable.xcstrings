          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine Automatisierung, die jeden Montag um 08:30 Uhr meine Kalenderereignisse der Woche zusammenfasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear una automatización que resuma los eventos del calendario de la semana cada lunes a las 08:30."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une automatisation qui résume les événements de votre agenda chaque lundi à 08 h30."
          }
