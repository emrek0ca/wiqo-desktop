    "İptal isteğinin sonucu belirsiz. Etkinlik'i yenileyip PC işinin durumunu kontrol et." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نتيجة طلب الإلغاء غير واضحة. حدث النشاط وتحقق من حالة مهمة الكمبيوتر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ergebnis der Abbruchanfrage ist unklar. Aktualisieren Sie die Aktivität und prüfen Sie den Status der PC-Aufgabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Result of cancel request is uncertain. Refresh the event and check the PC task status."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultado de la solicitud de cancelación incierto. Refresca el evento y verifica el estado del trabajo en PC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résultat de la demande d’annulation incertain. Rafraîchissez l’activité et vérifiez l’état du travail sur le PC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результат запроса отмены неизвестен. Обновите событие и проверьте статус работы ПК."
          }
        }
      }
    },
