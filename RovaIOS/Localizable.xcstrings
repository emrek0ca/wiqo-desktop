            "value": " J’attends votre confirmation pour"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " أنتظر موافقتك على ذلك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Жду вашего подтверждения."
          }
        }
      }
    },
    " · anahtarlı": {
      "extractionState": "manual",
      "localizations": {
        "en": {
