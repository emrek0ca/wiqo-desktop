    "Değişikliği başlatmak için projeye bir kez izin ver, sonra isteği buraya yaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant permission to the project once to initiate the change, then write the request here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube dem Projekt einmal, um die Änderung zu starten, dann schreibe die Anfrage hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iniciar el cambio, concede permiso al proyecto una vez y luego escribe la solicitud aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez une fois le projet, puis écrivez votre demande ici pour lancer la modification."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منح المشروع إذنًا مرة واحدة لبدء التغيير، ثم اكتب الطلب هنا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите проекту один раз, затем напишите запрос здесь."
