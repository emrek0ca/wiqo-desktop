          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not delete (check the connection); the project would have returned on other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo eliminar (verifica la conexión); el proyecto volvería en otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de supprimer (vérifiez la connexion) ; le projet reviendrait sur les autres appareils."
