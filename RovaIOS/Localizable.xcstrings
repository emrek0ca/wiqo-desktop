          }
        }
      }
    },
    "PC’ye şu anda ulaşamıyorum. Açık ve internete bağlı olduğundan emin olun." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا أستطيع الوصول إلى جهاز الكمبيوتر الآن. تأكد من تشغيله والاتصال بالإنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kann den PC derzeit nicht erreichen. Stellen Sie sicher, dass er eingeschaltet und mit dem Internet verbunden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can’t reach the PC right now. Make sure it’s on and connected to the internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedo acceder a la PC en este momento. Asegúrese de que esté encendida y conectada a Internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne peux pas accéder à l'ordinateur pour le moment. Assurez-vous qu'il est allumé et connecté à Internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас я не могу подключиться к ПК. Убедитесь, что он включён и подключён к интернету."
          }
        }
      }
    },
