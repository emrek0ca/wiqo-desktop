          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestalte das Design sauberer und ordentlicher; entferne unnötige Verzierungen und Überladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazúlla el diseño y organízalo; elimina adornos y desorden innecesarios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simplifiez le design, supprimez les décorations inutiles et la surcharge"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل التصميم أبسط وأكثر تنظيمًا؛ احذف الزخارف غير الضرورية والازدحام"
