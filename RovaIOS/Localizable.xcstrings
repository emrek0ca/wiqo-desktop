    "Her ayın 1'inde saat 09:00'da o ay için bütçe/faturalarımı gözden geçirmemi hatırlatan bir otomasyon oluştur." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ أتمتة تُذكّرني بمراجعة ميزانيتي/فواتيري في 09:00 يوم 1 من كل شهر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle eine Automatisierung, die jeden Monat am 1. um 09:00 Uhr mich daran erinnert, mein Budget/Meine Rechnungen für den Monat zu überprüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create an automation that reminds me to review my budget/bills for the month every 1st of the month at 9:00 AM."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crear una automatización que recuerde revisar el presupuesto/facturas del mes cada 1 de mes a las 09:00."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez une automatisation qui vous rappelle de revoir votre budget/factures du mois chaque 1er à 09 h00."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте автоматизацию, которая в первый день каждого месяца в 09:00 напомнит мне проверить бюджет/счета за месяц."
          }
        }
      }
    },
    "Her ayın ilk günü bir hatırlatma gönderir" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرسل تذكيرًا في أول يوم من كل شهر"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet jeden Monat am ersten Tag eine Erinnerung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends a reminder on the first day of every month"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía un recordatorio el primer día de cada mes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie un rappel le premier jour de chaque mois"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлять напоминание в первый день каждого месяца"
          }
        }
      }
    },
    "Her Cuma 18:00'de tamamlanmamış hatırlatıcılarımı özetleyen bir otomasyon oluştur." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ أتمتة تلخص التذكيرات غير المكتملة في 18:00 كل جمعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle eine Automatisierung, die jeden Freitag um 18:00 Uhr meine nicht abgeschlossenen Erinnerungen zusammenfasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create an automation that summarizes my unfinished reminders every Friday at 6 PM."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crear una automatización que resuma los recordatorios pendientes cada viernes a las 18:00."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez une automatisation qui résume les rappels non terminés chaque vendredi à 18 h."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте автоматизацию, которая в каждую пятницу в 18:00 подытожит незавершенные напоминания."
          }
        }
      }
    },
    "Her cuma akşamı haftalık raporumu hazırlayıp hatırlat" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
