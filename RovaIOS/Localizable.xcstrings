    "Gönderdiğin bilgiler geçersiz. Lütfen kontrol edip tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The information you sent is invalid. Please check and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die von dir gesendeten Informationen sind ungültig. Bitte überprüfe sie und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información que enviaste es inválida. Por favor revisa y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations que vous avez envoyées sont invalides. Veuillez vérifier et réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعلومات التي أرسلتها غير صالحة. يرجى التحقق والمحاولة مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправленные данные недействительны. Проверьте и попробуйте снова."
          }
        }
      }
    },
