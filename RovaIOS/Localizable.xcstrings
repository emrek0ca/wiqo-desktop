    "İşin bir kısmını yaptım; kalanını tamamlayamadım." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد أنجزت جزءًا من المهمة؛ لم أتمكن من إكمال الباقي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe einen Teil erledigt; den Rest konnte ich nicht abschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I did part of the task; I couldn't finish the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He hecho una parte del trabajo; no pude terminarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'ai fait une partie du travail ; je n'ai pas pu terminer le reste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я сделал часть работы; остальное не удалось завершить."
          }
        }
      }
    },
    "İşin durduğu doğrulanamadı; sonucu belirsiz olarak Etkinlik'te gösteriliyor." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم التحقق من توقف المهمة؛ يُعرض النتيجة غير محددة في النشاط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Status konnte nicht bestätigt werden; das Ergebnis wird als unbestimmt in der Aktivität angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The task's status couldn't be confirmed; it shows as Undetermined in Activity."
          }
        },
        "es" : {
