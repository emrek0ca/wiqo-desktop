          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zum Wiqo-Server fehlgeschlagen. Bitte später erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar al servidor de Wiqo. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
