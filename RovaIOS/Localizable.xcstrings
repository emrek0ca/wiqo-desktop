    "Mikrofon başlatılamadı; başka bir uygulama mikrofonu kullanıyor olabilir. Lütfen tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone could not be started; another app may be using it. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonstart ist fehlgeschlagen; eine andere App könnte das Mikrofon benutzen. Bitte erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el micrófono; otra aplicación puede estar usándolo. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le microphone ; une autre application pourrait l’utiliser. Veuillez réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تشغيل الميكروفون؛ قد يستخدم تطبيق آخر الميكروفون. حاول مرة أخرى."
          }
        },
        "ru": {
