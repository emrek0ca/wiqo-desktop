            "state": "translated",
            "value": "Wiqo startet den Server und meldet sich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo ejecuta el servidor y te notifica"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur Wiqo est lancé et informe"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُشغّل خادم Wiqo ويبلغك"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo запускает сервер и сообщает"
          }
        }
      }
    },
    "Wiqo sunucusu şu anda kullanılamıyor. Biraz sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo server is currently unavailable. Try again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo-Server ist momentan nicht verfügbar. Bitte später erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de Wiqo no está disponible en este momento. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur Wiqo est actuellement indisponible. Réessayez plus tard."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خادم Wiqo غير متاح حاليًا. حاول مرة أخرى لاحقًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер Wiqo сейчас недоступен. Попробуйте позже."
          }
        }
      }
    },
    "Wiqo sunucusuna bağlanılamadı. Biraz sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
