    "Wiqo hesabına bağlı değil.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not linked to a Wiqo account."
          }
        },
        "de": {
          "stringUnit": {
