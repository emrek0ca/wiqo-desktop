    "İptal edilemedi. Bağlantıyı kontrol edip yeniden dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot cancel. Check the connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann nicht abgebrochen werden. Prüfen Sie die Verbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cancelar. Verifica la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’annuler. Vérifiez la connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الإلغاء. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отменить. Проверьте соединение и повторите попытку."
          }
        }
      }
    },
    "İptal edilemedi; proje bitmiş olabilir. Birazdan kart güncellenecek.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot cancel; the project may be finished. The card will update shortly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann nicht abgebrochen werden; das Projekt könnte beendet sein. Die Karte wird in Kürze aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cancelar; el proyecto puede haber terminado. La tarjeta se actualizará pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’annuler ; le projet peut être terminé. La carte sera mise à jour sous peu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الإلغاء؛ قد يكون المشروع قد انتهى. سيتم تحديث البطاقة قريباً."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отменить; проект может быть завершён. Карта обновится через несколько минут."
          }
        }
      }
    },
