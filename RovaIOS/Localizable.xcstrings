    "Proje iptal edilemedi; bitmiş ya da zaten durmuş olabilir. Listeyi yeniledim.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project could not be cancelled; it may have already finished or stopped. Refreshed the list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt konnte nicht abgebrochen werden; es ist möglicherweise bereits beendet oder gestoppt. Liste wurde aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cancelar el proyecto; puede haber terminado o ya estar detenido. Actualicé la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'annuler le projet ; il peut être terminé ou déjà arrêté. J'ai actualisé la liste."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إلغاء المشروع؛ ربما انتهى أو توقف بالفعل. قمت بتحديث القائمة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проект не удалось отменить; он может быть завершён или уже остановлен. Обновил список."
          }
        }
      }
    },
