    },
    "Wiqo ile eşleştirilmiş PC'yi uzaktan kilitler." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقفل Wiqo على PC المتطابق عن بُعد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiqo sperrt den verbundenen PC aus der Ferne"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiqo locks the paired PC remotely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiqo bloquea el PC emparejado a distancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiqo verrouille à distance le PC apparié."
          }
        },
