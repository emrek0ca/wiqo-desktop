            "state": "translated",
            "value": "Verify your identity to allow these types of actions to run without approval."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um solche Aktionen ohne Genehmigung auszuführen, verifiziere deine Identität."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para permitir la ejecución sin autorización de este tipo de acciones, verifica tu identidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour autoriser l’exécution non autorisée de ce type d’action, vérifiez votre identité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للسماح بتنفيذ هذه الأنواع من الأفعال دون موافقة، قم بالتحقق من هويتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите свою личность, чтобы разрешить выполнение таких действий без подтверждения."
          }
        }
      }
    },
