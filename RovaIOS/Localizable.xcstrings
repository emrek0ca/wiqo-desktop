    "PC bağlantısı koptu; işlemin sonucu doğrulanamadı. Aynı komutu otomatik tekrar çalıştırmadım." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم قطع اتصال الكمبيوتر؛ لم يتم التحقق من نتيجة العملية. لم أعد تشغيل الأمر تلقائياً مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC-Verbindung abgebrochen; Ergebnis konnte nicht bestätigt werden. Der Befehl wurde nicht automatisch erneut ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC connection interrupted; the result could not be verified. I did not automatically retry the same command."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexión al PC perdida; el resultado de la operación no se pudo verificar. No reintenté automáticamente el mismo comando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion PC a été perdue ; le résultat de l’opération n’a pas pu être vérifié. Je n’ai pas relancé la même commande automatiquement."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение с ПК потеряно; результат операции не подтверждён. Я не запустил автоматический повтор."
          }
        }
      }
    },
