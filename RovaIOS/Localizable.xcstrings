            "state": "translated",
            "value": "Neustart fehlgeschlagen. Verbindung prüfen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reiniciar. Verifica la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
