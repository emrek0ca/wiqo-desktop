    "Oturumun geçersiz veya süresi dolmuş. Lütfen tekrar giriş yap.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session invalid or expired. Please log in again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung ungültig oder abgelaufen. Bitte melde dich erneut an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión es inválida o ha expirado. Por favor, inicia sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session est invalide ou a expiré. Veuillez vous reconnecter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجلسة غير صالحة أو انتهت صلاحيتها. يرجى تسجيل الدخول مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
