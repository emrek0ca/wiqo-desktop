    "Projelerin cihazların arasında şifreli gider; anahtar yalnız sende, sunucu içeriği okuyamaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project data is encrypted across devices; only you hold the key, the server cannot read the content."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Projekte werden verschlüsselt zwischen den Geräten übertragen; der Schlüssel ist nur bei dir, der Server kann den Inhalt nicht lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos se transfieren cifrados entre dispositivos; la clave solo está en tu mano, el servidor no puede leer el contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets sont chiffrés entre les appareils ; la clé est uniquement chez vous, le serveur ne peut pas lire le contenu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم نقل المشاريع بين الأجهزة بشكل مشفر؛ المفتاح لديك فقط، لا يمكن للخادم قراءة المحتوى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проекты шифруются между устройствами; ключ хранится только у вас, сервер не может читать содержимое."
          }
        }
      }
    },
