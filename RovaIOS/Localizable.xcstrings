    "Dosyaların indirme süresi doldu; istersen yeniden oluşturabilirim.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download time for the files has expired; I can recreate them if you wish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download der Dateien ist abgelaufen; ich kann sie bei Bedarf neu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de descarga de los archivos ha expirado; si lo deseas, puedo volver a crearlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai de téléchargement des fichiers est expiré ; je peux le recréer si vous le souhaitez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى وقت تنزيل الملفات؛ يمكنني إعادة إنشائها إذا رغبت."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время скачивания файлов истекло; если хотите, могу создать заново."
          }
        }
      }
    },
    "Dosyaların sunucuda yalnız şifreli durur; anahtar sadece cihazlarında.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are stored encrypted on the server; the key is only on your devices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien bleiben auf dem Server nur verschlüsselt; der Schlüssel ist nur auf deinen Geräten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos permanecen cifrados solo en el servidor; la clave solo está en tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers restent uniquement chiffrés sur le serveur ; la clé est uniquement sur vos appareils."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات تبقى مشفرة على الخادم فقط؛ المفتاح موجود على أجهزتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы на сервере хранятся только зашифрованными; ключ хранится только на ваших устройствах."
          }
        }
      }
    },
    "Dosyanın kendisi gönderilmez; telefonda çıkarılan içerik gönderilir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file itself is not sent; the content removed from the phone is sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei selbst wird nicht gesendet; der Inhalt, der auf dem Telefon entfernt wurde, wird gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo en sí no se envía; se envía el contenido extraído del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier lui‑même n’est pas envoyé ; le contenu extrait du téléphone est envoyé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف نفسه لا يُرسل؛ يُرسل المحتوى المُزال من الهاتف."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сам файл не отправляется; отправляется содержимое, которое вы выбрали на телефоне."
          }
        }
      }
    },
