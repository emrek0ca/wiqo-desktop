    "Eklerin toplam boyutu çok büyük. Daha az dosya veya görsel ekleyip tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The total size of attachments is too large. Try adding fewer files or images and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gesamtgröße der Anhänge ist zu groß. Versuche, weniger Dateien oder Bilder hinzuzufügen und erneut zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño total de los archivos adjuntos es demasiado grande. Intenta con menos archivos o imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille totale des pièces jointes est trop grande. Ajoutez moins de fichiers ou d'images et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم المرفقات الإجمالي كبير جدًا. حاول إضافة ملفات أو صور أقل ثم أعد المحاولة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общий размер вложений слишком велик. Добавьте меньше файлов или изображений и попробуйте снова."
          }
        }
      }
    },
