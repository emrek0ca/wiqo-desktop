    "Oturum izni hemen kapatılır. PC çevrimdışıysa başlamış bir işin durduğu doğrulanamayabilir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session permission closes immediately. If PC is offline, a running job may not be verified as stopped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzungsgenehmigung wird sofort beendet. Wenn der PC offline ist, kann nicht verifiziert werden, ob ein laufender Prozess gestoppt wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autorización de sesión se cierra inmediatamente. Si el PC está desconectado, no se puede verificar si una tarea en curso se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La permission de session se ferme immédiatement. Si le PC est hors ligne, il peut ne pas être possible de vérifier qu'un travail en cours a été arrêté."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إغلاق إذن الجلسة فوراً. إذا كان PC غير متصل، قد لا يمكن التحقق من توقف مهمة بدأت"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение сеанса будет закрыто мгновенно. Если PC офлайн, может быть невозможно подтвердить остановку запущенной задачи."
          }
        }
      }
    },
    "Oturum kapatılamadı. Etkinlik'i yenileyip durumu tekrar kontrol et.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session could not close. Refresh activity and check status again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung konnte nicht beendet werden. Aktualisiere die Aktivität und prüfe den Status erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cerrar la sesión. Actualiza la actividad y verifica el estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session n’a pas pu être fermée. Rafraîchissez l’activité et vérifiez à nouveau le statut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إغلاق الجلسة. حدّث النشاط وتحقق من الحالة مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить сеанс. Обновите событие и проверьте статус снова."
          }
        }
      }
    },
    "Oturum sona erdi; yanıt alınamadı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session ended; no response received."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung abgelaufen; keine Antwort erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión expiró; no se obtuvo respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session est terminée ; aucune réponse reçue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت الجلسة؛ لا يمكن الحصول على رد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс завершен; ответ не получен."
          }
        }
      }
    },
    "Oturumu kapat": {
