    "Dosyalar ve geçmiş tüm cihazlardan silinir; geri alınamaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All files and history will be deleted from all devices; this cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Dateien und der Verlauf werden von allen Geräten gelöscht; nicht wiederherstellbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos y el historial se eliminarán de todos los dispositivos; no se pueden recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers et l’historique seront supprimés de tous les appareils ; irréversible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف الملفات وسجلها من جميع الأجهزة؛ لا يمكن التراجع."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы и история будут удалены со всех устройств; восстановление невозможно."
          }
        }
      }
    },
