    "Telefonda denenemedi; değişiklik kaydedildi. Çalışmıyorsa geri alabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not test on phone; changes saved. If it doesn’t work, you can revert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Telefon nicht getestet; Änderungen wurden gespeichert. Wenn es nicht funktioniert, kannst du zurückkehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo probar en el móvil; cambios guardados. Si no funciona, puedes revertir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essai sur le téléphone échoué ; changement enregistré. Vous pouvez revenir en arrière si cela ne fonctionne pas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم التجربة على الهاتف؛ تم حفظ التغيير. إذا لم يعمل يمكنك التراجع."
