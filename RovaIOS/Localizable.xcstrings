    "App Store fiyatı şu anda alınamadı. Az sonra tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الحصول على سعر App Store الآن. حاول مرة أخرى لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App‑Store‑Preis konnte derzeit nicht abgerufen werden. Versuche es in Kürze erneut."
          }
        },
        "en" : {
          "stringUnit" : {
