    "Apple son ödemeyi alamadı. Ödeme yöntemini güncelle; o zamana kadar Pro açık kalır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple could not collect the last payment. Update your payment method; Pro will remain active until then."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple konnte die letzte Zahlung nicht erhalten. Aktualisiere deine Zahlungsmethode; bis dahin bleibt Pro aktiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no pudo cobrar el último pago. Actualiza tu método de pago; Pro permanecerá activo hasta entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n'a pas pu récupérer le dernier paiement. Mettez à jour votre méthode de paiement ; Pro restera actif jusqu'à ce que le problème soit résolu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple لم تستلم الدفعة الأخيرة. حدّث وسيلة الدفع؛ ستظل Pro نشطة حتى ذلك الوقت."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не смогла получить последнюю оплату. Обновите способ оплаты; до тех пор Pro останется активным."
          }
        }
      }
    },
