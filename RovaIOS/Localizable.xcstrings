    "Wiqo Pro bu Apple hesabının mağazasında henüz kullanılamıyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro is not yet available in the Apple account's store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro ist im Apple Store dieses Apple-Kontos noch nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro aún no está disponible en la tienda de esta cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro n'est pas encore disponible dans le magasin de ce compte Apple."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro غير متاح بعد في متجر حساب Apple هذا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiqo Pro пока недоступен в магазине этого Apple‑аккаунта."
          }
        }
      }
    },
    "Wiqo Pro bu mağaza bölgesinde kullanılamıyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
