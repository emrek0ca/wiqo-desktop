        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datei konnte nicht geöffnet werden; möglicherweise beschädigt oder passwortgeschützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File could not be opened; it may be corrupted or password protected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir el archivo; puede estar dañado o protegido por contraseña."
