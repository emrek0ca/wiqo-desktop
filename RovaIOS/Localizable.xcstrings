      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me about your preferences, environment, and frequent tasks; I’ll remember them for future chats. You can delete them here anytime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzähle mir deine Vorlieben, deine Umgebung und die Aufgaben, die du häufig erledigst; ich werde sie in zukünftigen Gesprächen berücksichtigen. Du kannst sie jederzeit hier löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dime tus preferencias, tu entorno y las tareas que haces con frecuencia; las recordaré en las próximas conversaciones. Puedes borrarlas aquí cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-moi vos préférences, votre environnement et les tâches que vous faites souvent ; je me souviendrai lors des prochaines conversations. Vous pouvez les supprimer ici quand vous voulez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبرني عن تفضيلاتك، بيئتك، وأعمالك المتكررة؛ سأتذكرها في المحادثات القادمة. يمكنك حذفها من هنا في أي وقت."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите мне о своих предпочтениях, окружении и часто выполняемых задачах; я запомню их для будущих бесед. При желании вы можете удалить их здесь."
          }
        }
      }
    },
    "Terminal izni bu telefonda imzalanamadı. PC eşleşmesini kontrol et.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal permission could not be signed on this phone. Check PC pairing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal-Berechtigung konnte auf diesem Telefon nicht signiert werden. Prüfe die PC‑Kopplung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de terminal no se firmó en este móvil. Verifica la sincronización con PC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation Terminal non signée sur ce téléphone. Vérifiez la synchronisation PC."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم توقيع إذن الطرفية على هذا الهاتف. تحقق من التوافق مع الكمبيوتر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение терминала не подписано на этом телефоне. Проверьте соответствие PC."
          }
        }
      }
    },
    "Terminal izni bu telefonda imzalanamadı. PC eşleşmesini kontrol ettikten sonra yeniden deneyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal permission could not be signed on this phone. After checking PC pairing, try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal-Berechtigung konnte auf diesem Telefon nicht signiert werden. Nach Prüfung der PC‑Kopplung erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de terminal no se firmó en este móvil. Después de verificar la sincronización con PC, intenta de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation Terminal non signée sur ce téléphone. Après vérification de la synchronisation PC, réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم توقيع إذن الطرفية على هذا الهاتف. بعد التحقق من التوافق مع الكمبيوتر يمكنك المحاولة مرة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение терминала не подписано на этом телефоне. После проверки соответствия PC попробуйте снова."
          }
        }
      }
    },
    "Terminal işi durduruldu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal job stopped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalaufgabe abgebrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo de terminal se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tâche Terminal arrêtée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف عمل الطرفية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминальная задача остановлена."
          }
        }
      }
    },
    "Terminal işi iptal edilemedi veya sonucu belirsiz. Etkinlik'i yenileyip durumu kontrol et.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal job could not be cancelled or result is unclear. Refresh the activity and check status."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalaufgabe konnte nicht abgebrochen werden oder Ergebnis unbestimmt. Aktualisiere die Aktivität und prüfe den Status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cancelar el trabajo de terminal o el resultado es incierto. Refresca la actividad y verifica el estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tâche Terminal non annulée ou résultat incertain. Rafraîchissez l’activité et vérifiez l’état."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يمكن إلغاء عمل الطرفية أو النتيجة غير واضحة. أعد تحميل النشاط وتحقق من الحالة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминальная задача не отменена или результат не определён. Обновите событие и проверьте статус."
          }
        }
      }
    },
    "Terminal oturumu kapatıldı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal session closed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalsession beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de terminal se cerró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session Terminal fermée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إغلاق جلسة الطرفية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия терминала завершена."
          }
        }
      }
    },
    "Terminal oturumu kapatıldı; PC çevrimdışı olduğu için %lld başlamış işin durduğu doğrulanamadı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal session closed; because PC is offline, it could not confirm that %lld started work has stopped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalsession beendet; PC offline, daher konnte nicht bestätigt werden, ob %lld gestartete Aufgabe gestoppt wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de terminal se cerró; no se pudo confirmar que el trabajo iniciado con %lld se detuvo porque el PC está desconectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session Terminal fermée ; PC hors ligne, il n’est pas possible de confirmer que le travail a commencé à %lld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إغلاق جلسة الطرفية؛ لا يمكن تأكيد بدء عملك لأن الكمبيوتر غير متصل، تم تشغيله منذ %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия терминала завершена; так как PC офлайн, не удалось подтвердить, что %lld начатая работа остановлена."
          }
        }
      }
    },
