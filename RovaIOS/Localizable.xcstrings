    "Hesabın, sohbet hafızan, otomasyonların ve eşleşmiş cihazların kalıcı olarak silinir." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف حسابك، وذاكرة المحادثة، وأتمتاتك، والأجهزة المتطابقة نهائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto, dein Chat-Speicher, deine Automatisierungen und deine verbundenen Geräte werden dauerhaft gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account, chat memory, automations and paired devices will be permanently deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán permanentemente tu cuenta, historial de conversación, automatizaciones y dispositivos vinculados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte, ta mémoire de discussion, tes automatisations et tes appareils appariés seront supprimés définitivement."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш аккаунт, чат‑память, автоматизации и сопряжённые устройства будут удалены навсегда."
          }
        }
      }
    },
