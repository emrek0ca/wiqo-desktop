    "İkisini birleştirmek için iki dosyayı bir editörde aç (Mac'teki klasörde yan yana durur).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open both files side‑by‑side in an editor (they sit next to each other in the folder on Mac)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die beiden Dateien in einem Editor, um sie zu kombinieren (auf dem Mac nebeneinander in einem Ordner)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los dos archivos en un editor para combinarlos (se muestran uno al lado del otro en la carpeta de Mac)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez les deux fichiers dans un éditeur pour les fusionner (ils s’affichent côte à côte dans le dossier sur Mac)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الملفين في محرر واحد (يظهر بجانب بعضه في مجلد على ماك)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы объединить их, откройте оба файла в редакторе (на Mac они расположены рядом в папке)."
          }
        }
      }
