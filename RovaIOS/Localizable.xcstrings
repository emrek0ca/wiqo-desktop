    "30 gün geçerli, günde en fazla 10 kez. Mail göndermek ve silmek her zaman onay ister.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid for 30 days, up to 10 times per day. Sending or deleting mail always requires confirmation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "30 Tage gültig, maximal 10 Mal pro Tag. Senden und Löschen von E‑Mails erfordern immer Bestätigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Válido 30 días, máximo 10 veces al día. Enviar y eliminar correos siempre requiere confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 jours valides, maximum 10 fois par jour. Envoyer ou supprimer un e‑mail demande toujours confirmation."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "30 يوم صالح، أقصى 10 مرات يوميًا. إرسال البريد وحذفه يتطلب تأكيدًا دائمًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "30 дней действует, максимум 10 раз в день. Отправка и удаление писем всегда требуют подтверждения."
          }
        }
      }
    },
