    "Her Cuma 18:00'de tamamlanmamış hatırlatıcılarımı özetleyen bir otomasyon oluştur.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an automation that summarizes my unfinished reminders every Friday at 6 PM."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine Automatisierung, die jeden Freitag um 18:00 Uhr meine nicht abgeschlossenen Erinnerungen zusammenfasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear una automatización que resuma los recordatorios pendientes cada viernes a las 18:00."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une automatisation qui résume les rappels non terminés chaque vendredi à 18 h."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ أتمتة تلخص التذكيرات غير المكتملة في 18:00 كل جمعة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте автоматизацию, которая в каждую пятницу в 18:00 подытожит незавершенные напоминания."
          }
        }
      }
    },
    "Her Pazar 20:00'de İndirilenler klasöründeki 30 günden eski dosyaları listeleyip benden onay isteyen bir otomasyon oluştur.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an automation that lists files older than 30 days in the Downloads folder every Sunday at 8 PM and asks me for confirmation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine Automatisierung, die jeden Sonntag um 20:00 Uhr Dateien im Ordner Downloads, die älter als 30 Tage sind, auflistet und mich um Bestätigung bittet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear una automatización que liste los archivos de más de 30 días en la carpeta Descargas cada domingo a las 20:00 y solicite mi aprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une automatisation qui liste les fichiers de plus de 30 jours dans le dossier Téléchargements chaque dimanche à 20 h et demande votre confirmation."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ أتمتة تُظهر الملفات التي تجاوزت 30 يومًا في مجلد التنزيلات في 20:00 كل أحد وتطلب موافقتي."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте автоматизацию, которая в каждое воскресенье в 20:00 перечислит файлы старше 30 дней в папке «Загружено» и попросит у меня подтверждение."
          }
        }
      }
    },
    "Her Pazartesi 08:30'da o haftaki takvim etkinliklerimi özetleyen bir otomasyon oluştur.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an automation that summarizes my calendar events for the week every Monday at 8:30 AM."
          }
        },
