    "Pro aktif. Hoş geldin!" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشط برو. مرحبًا!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro aktiv. Willkommen!"
