          }
        }
      }
    },
    "Konum; hava durumu ve yakındaki öneriler için kullanılır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is used for weather and nearby suggestions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Location; used for weather and nearby suggestions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicación; se usa para el clima y recomendaciones cercanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’emplacement est utilisé pour la météo et les suggestions à proximité"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموقع؛ يُستخدم لعرض الطقس والاقتراحات القريبة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение используется для погоды и ближайших рекомендаций"
          }
        }
      }
    },
    "Konumun gerekiyor. Konum izni verirsen rotayı ve yakındaki yerleri burada gösterebilirim; konum yalnızca telefonda kalır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is required. If you grant location permission, I can show the route and nearby places here; the location stays on the phone only."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is needed. If you grant location permission, I can show the route and nearby places here; the location stays only on the phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos tu ubicación. Si otorgas permiso, puedo mostrar la ruta y lugares cercanos aquí; la ubicación permanece solo en el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’emplacement est requis. Si vous autorisez l’accès, je peux afficher l’itinéraire et les lieux proches ; l’emplacement reste uniquement sur votre téléphone"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموقع مطلوب. إذا سمحت بإذن الموقع، يمكنني عرض الطريق والأماكن القريبة هنا؛ يبقى الموقع على الهاتف فقط."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение необходимо. Если вы дадите разрешение, я покажу маршрут и ближайшие места; местоположение останется только на телефоне"
          }
        }
      }
    },
    "Konuşarak yaz": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak to type"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
