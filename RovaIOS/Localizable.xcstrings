    "Konum iznini aç" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فتح إذن الموقع"
          }
        },
        "de" : {
          "stringUnit" : {
