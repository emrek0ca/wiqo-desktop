    "Birden fazla PC'n varsa isim vererek ayırt edebilirsin (\"Ofis PC\" gibi)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان لديك أكثر من PC، يمكنك تمييزها بأسماء (مثل \"PC المكتب\")."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du mehrere PCs hast, kannst du sie mit Namen unterscheiden (z. B. „Office-PC“)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have multiple PCs, give them names to distinguish (e.g., “Office PC”)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes varios PC, puedes distinguirlos con nombres (por ejemplo, \"PC Oficina\")."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous avez plusieurs PC, donnez-leur un nom pour les différencier (par ex. « PC de bureau »)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если у вас несколько ПК, можно различать их по имени (например, «Офисный ПК»)."
