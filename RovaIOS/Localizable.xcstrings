    "Satın alma onay bekliyor (Ask to Buy). Onaylanınca otomatik aktif olacak.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase pending approval (Ask to Buy). It will activate automatically once approved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf wartet auf Genehmigung (Ask to Buy). Sobald genehmigt, wird es automatisch aktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra está pendiente de aprobación (Ask to Buy). Se activará automáticamente cuando se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat attend l'approbation (Ask to Buy). Il deviendra actif automatiquement une fois approuvé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشراء في انتظار الموافقة (طلب شراء). سيصبح نشطًا تلقائيًا عند الموافقة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает подтверждения (Ask to Buy). После одобрения будет активирована автоматически."
          }
        }
      }
    },
