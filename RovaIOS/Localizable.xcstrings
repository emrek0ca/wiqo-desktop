          }
        }
      }
    },
    "\"%@\": dosyalar ve geçmiş tüm cihazlardan silinir; geri alınamaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": files and history will be deleted from all devices; irreversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": Dateien und Verlauf werden von allen Geräten gelöscht; unwiderruflich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": se eliminarán los archivos y el historial de todos los dispositivos; irreversible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": les fichiers et l’historique seront supprimés de tous les appareils; irréversible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": ستُحذف الملفات وسجلها من جميع الأجهزة؛ لا يمكن التراجع."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": файлы и история будут удалены со всех устройств; действие необратимо."
          }
        }
      }
    },
    "\"Sesi kıs\"": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Mute\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Lautstärke senken\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Silenciar\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Réduire le son\""
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"أخفض الصوت\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Снять звук\""
          }
        }
      }
    },
    "# Shell komutlarını buraya yaz\necho merhaba": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Write shell commands here\necho hello"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# Schreibe hier Shell-Befehle\necho merhaba"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Escribe los comandos Shell aquí\necho merhaba"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# Écrivez les commandes Shell ici\necho merhaba"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "# اكتب أوامر Shell هنا\necho merhaba"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# Введите команды Shell здесь\necho merhaba"
          }
        }
      }
    },
