    "Hedefler yüklenemedi. Yeniden denemek için aşağı çek.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Targets could not be loaded. Pull down to retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziele konnten nicht geladen werden. Ziehe nach unten, um es erneut zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los destinos. Desliza hacia abajo para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cibles n’ont pas pu être chargées. Faites glisser vers le bas pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل الأهداف. اسحب لأسفل لإعادة المحاولة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить цели. Перетащите вниз, чтобы повторить попытку."
          }
        }
      }
    },
    "Hedeflerini sohbette Wiqo'ya söyle. Alt görevler tamamlandıkça ilerleme burada güncellenir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell Wiqo your goals in chat. Progress updates here as sub‑tasks finish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzähle Wiqo in der Unterhaltung deine Ziele. Sobald Unteraufgaben abgeschlossen sind, wird der Fortschritt hier aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a Wiqo tus objetivos en la conversación. A medida que se completen subtareas, el progreso se actualizará aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discuter tes objectifs avec Wiqo. La progression se met à jour ici au fur et à mesure que les sous‑tâches sont terminées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبر Wiqo عن أهدافك في الدردشة. مع إكمال المهام الفرعية، يتم تحديث التقدم هنا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажите Wiqo о своих целях в чате. По мере завершения подзадач прогресс обновляется здесь."
          }
        }
      }
    },
