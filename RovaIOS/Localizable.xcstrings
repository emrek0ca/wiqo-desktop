    "Wiqo hesabından çıkmak istediğine emin misin?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد أنك تريد تسجيل الخروج من حساب Wiqo؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du sicher, dass du dich aus dem Wiqo-Konto abmelden möchtest?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to sign out of Wiqo?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro de que quieres cerrar sesión en la cuenta de Wiqo?"
          }
        },
        "fr" : {
          "stringUnit" : {
