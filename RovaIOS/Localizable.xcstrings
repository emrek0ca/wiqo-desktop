    "PC'ye gönderilmiş bir adımın sonucu belirsiz kalabilir; Wiqo bunu Etkinlik'te gösterecek." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يظل نتيجة خطوة مرسلة إلى PC غير محددة؛ سيعرض Wiqo ذلك في النشاط"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ergebnis eines über den PC gesendeten Schritts kann unbestimmt bleiben; Wiqo zeigt es in der Aktivität an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The result of a step sent to PC may be uncertain; Wiqo will show it in Events."
