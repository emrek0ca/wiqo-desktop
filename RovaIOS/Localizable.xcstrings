    "Rehber izni gerekiyor. İzin verirsen kişiyi burada bulup arayabilirsin; rehber telefonda kalır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact permission required. If you grant it, you can find and call the person here; the contact stays on the phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kontakt muss in der Telefonliste vorhanden sein. Wenn du die Erlaubnis erteilst, kannst du die Person hier finden und anrufen; der Kontakt bleibt auf dem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita permiso de contactos. Si lo otorgas, puedes encontrar y llamar a la persona aquí; los contactos permanecen en el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation de contacts est requise. Si vous l'accordez, vous pourrez trouver et appeler la personne ici ; les contacts restent sur le téléphone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب إذن دليل الاتصال. إذا سمحت، يمكنك العثور على الشخص هنا والاتصال به؛ الدليل يبقى على الهاتف."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для доступа к адресной книге нужна разрешение. Если разрешите, вы сможете найти и позвонить человеку здесь; адресная книга останется на телефоне."
          }
        }
      }
    },
