<Window
    x:Class="RovaWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="32">
        <StackPanel Spacing="12" MaxWidth="520">
            <TextBlock Text="Wiqo" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Bilgisayarını telefonundan, konuşarak yönet." FontSize="18" />
            <TextBlock x:Name="StatusText" Text="Wiqo açılıyor…" Opacity="0.7" />
            <TextBlock x:Name="PairingHint" Text="Bu kodu Wiqo uygulamasında tara." TextWrapping="Wrap" Opacity="0.7" />
            <Border x:Name="PairingBorder" Padding="12" HorizontalAlignment="Left" Visibility="Collapsed">
                <Image x:Name="PairingImage" Width="280" Height="280" Stretch="Uniform" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
