<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Sibling projects live in subfolders; they are not part of the core library. -->
    <Compile Remove="Tests/**;App/**" />
    <None Remove="Tests/**;App/**" />
    <InternalsVisibleTo Include="RovaWindows.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared operation catalogue (exported from RovaShared); see Core/OperationCatalog.cs. -->
    <EmbeddedResource Include="../contracts/companion/operations.json" LogicalName="RovaWindows.operations.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
</Project>
