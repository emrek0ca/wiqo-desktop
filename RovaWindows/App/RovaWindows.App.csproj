<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RovaWindows.App</RootNamespace>
    <AssemblyName>Wiqo</AssemblyName>
    <ApplicationIcon>Assets\wiqo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Wiqo</Product>
    <Company>Wiqo</Company>
    <Description>Wiqo Windows yardımcısı</Description>
    <Version>0.9.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is used only for the tray icon; its implicit usings would clash with WPF names. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RovaWindows.csproj" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\wiqo.ico" />
    <Resource Include="Assets\wiqo-256.png" />
  </ItemGroup>
</Project>
