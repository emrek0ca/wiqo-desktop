<Window x:Class="RovaWindows.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wiqo" Width="480" Height="680"
        Style="{StaticResource WiqoWindow}" Icon="Assets/wiqo.ico">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Surface}" Padding="20,10">
            <Grid>
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Günlükler" Style="{StaticResource Quiet}" Click="OnOpenLogs"/>
                    <Button x:Name="PairButton" Style="{StaticResource Quiet}" Click="OnPairToggle" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,22,24,24">
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/wiqo-256.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Wiqo" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="DeviceText" Foreground="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="WIQO BU BİLGİSAYARDA NELERİ YAPABİLİR" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Card}" Padding="16,6">
                    <StackPanel x:Name="GroupList"/>
                </Border>

                <TextBlock Text="TERMİNAL" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <CheckBox x:Name="TerminalSwitch" Style="{StaticResource Switch}" Checked="OnTerminalChanged" Unchecked="OnTerminalChanged">
                        <StackPanel>
                            <TextBlock Text="Terminal oturumları" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Body}" FontSize="12" Text="Telefonundan onayladığın klasörde, onayın süresi boyunca PowerShell komutları, dosya okuma ve düzenleme."/>
                        </StackPanel>
                    </CheckBox>
                </Border>

                <TextBlock Text="GENEL" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <CheckBox x:Name="AutoStartSwitch" Style="{StaticResource Switch}" Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged">
                        <StackPanel>
                            <TextBlock Text="Bilgisayar açılınca başlat" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Body}" FontSize="12" Text="Wiqo bildirim alanında sessizce çalışır; telefonundan gelen isteklere hazır olur."/>
                        </StackPanel>
                    </CheckBox>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
