<Window x:Class="RovaWindows.App.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wiqo · Act" Width="660" Height="540" MinWidth="520" MinHeight="420"
        Style="{StaticResource WiqoWindow}" ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Act · Projeler" Style="{StaticResource Title}"/>
            <TextBlock Text="iPhone ve Mac projelerin bu bilgisayarda. Düzenlemeler şifreli olarak eşitlenir." Style="{StaticResource Body}" Margin="0,8,0,16"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="iPhone · Act · Kurtarma kodu" FontWeight="SemiBold"/>
                <PasswordBox x:Name="Recovery" Margin="0,8" Padding="8" MaxLength="100" AutomationProperties.Name="Act kurtarma kodu"/>
                <Button x:Name="EnableButton" Content="Bu klasörde senkronu etkinleştir" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="EnableSync"/>
            </StackPanel>
        </Border>
        <ListBox Grid.Row="2" x:Name="ProjectList" BorderThickness="0" Background="{StaticResource Surface}" AutomationProperties.Name="Projeler" MouseDoubleClick="OpenSelected">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="StatusLabel" Style="{StaticResource Body}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="SyncButton" Content="Şimdi eşitle" Click="SyncNow" Padding="12,8" Margin="0,0,8,0"/>
                <Button Content="Proje klasörünü aç" Click="OpenRoot" Padding="12,8"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
